{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "module": "ESNext",
    "allowUmdGlobalAccess": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "src/@types/*.d.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "**/*.js",
    "**/*.jsx"
  ]
}
