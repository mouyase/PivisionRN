{
  "name": "my-expo-app",
  "version": "1.0.0",
  "scripts": {
    "android": "bun --bun expo start --android",
    "ios": "bun --bun expo start --ios",
    "start": "bun --bun expo start",
    "prebuild": "bun --bun expo prebuild",
    "lint": "bun --bun eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "bun --bun eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "bun --bun expo start --web"
  },
  "dependencies": {
    "expo": "54.0.0-preview.8",
    "expo-status-bar": "~3.0.4",
    "nativewind": "latest",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-reanimated": "~4.0.2",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@types/react": "~19.1.10",
    "eslint": "^9.34.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-native-reanimated-monorepo": "react-native-reanimated/plugin",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  },
  "main": "node_modules/expo/AppEntry.js",
  "private": true
}
