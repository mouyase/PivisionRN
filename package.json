  "main": "expo-router/entry",
  "name": "pivisionrn",
  "private": true,
  "scripts": {
    "android": "expo run:android --port 65500 --variant debugOptimized",
    "android:clean": "yes | expo prebuild --clean && expo prebuild && expo run:android --port 65500 --variant debugOptimized",
    "android:release": "eas build --local --platform android --profile preview",
    "check:type": "tsc --jsx react-native --noEmit --locale zh-CN",
    "ios": "yes | expo prebuild && yes | expo run:ios --port 65500 --device",
    "ios:clean": "expo prebuild --clean && yes | expo run:ios --port 65500 --device",
    "lint": "oxlint --type-aware --type-check && eslint",
    "lint:fix": "oxfmt --no-error-on-unmatched-pattern && oxlint --type-aware --type-check --fix && eslint --fix",
    "pre-commit": "lefthook run pre-commit",
    "prebuild": "expo prebuild",
    "prebuild:clean": "yes | expo prebuild --clean",
    "start": "expo start --clear --dev-client -p 65500",
    "test": "jest --verbose",
    "test:ci": "CI=true jest --ci --verbose",
    "test:watch": "jest --watchAll --verbose",
    "web": "expo start --web"
  },
  "version": "1.0.0"
